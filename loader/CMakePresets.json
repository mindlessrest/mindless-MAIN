{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows-clang",
            "displayName": "Windows x64 - Clang",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "C:/Users/anthony/Tools/LLVM/bin/clang-cl.exe",
                "CMAKE_CXX_COMPILER": "C:/Users/anthony/Tools/LLVM/bin/clang-cl.exe",
                "CMAKE_LINKER": "C:/Users/anthony/Tools/LLVM/bin/lld-link.exe",
                "CMAKE_MAKE_PROGRAM": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
                "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-clang-debug",
            "displayName": "Debug",
            "configurePreset": "windows-clang",
            "configuration": "Debug"
        },
        {
            "name": "windows-clang-release",
            "displayName": "Release",
            "configurePreset": "windows-clang",
            "configuration": "Release"
        }
    ]
}
